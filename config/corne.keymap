#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        focusLeftEditor: vscFocusEditor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K) &kp LG(LEFT_ARROW)>;
            label = "VSCFOCUSEDITOR";
        };

        focusRightEditor: focusRightEditor {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(K) &kp LG(RIGHT_ARROW)>;
            label = "FOCUSRIGHTEDITOR";
        };

        mvEditorNext: mvEditorLeft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(L))>;
            label = "MVEDITORLEFT";
        };

        mvEditorPrev: mvEditorRight {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(H))>;
            label = "MVEDITORRIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE  &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y          &kp U  &kp I         &kp O    &kp P     &kp BACKSLASH
&kp TAB     &kp A  &kp S  &kp D     &kp F  &kp G        &kp H          &kp J  &kp K         &kp L    &kp SEMI  &kp SQT
&kp LSHIFT  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N          &kp M  &kp COMMA     &kp DOT  &kp FSLH  &kp LEFT_CONTROL
                          &kp LGUI  &mo 1  &kp SPACE    &kp BACKSPACE  &mo 2  &kp LEFT_ALT
            >;
        };

        lower_layer {
            bindings = <
&kp LC(GRAVE)   &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5    &kp NUMBER_6  &kp NUMBER_7    &kp NUMBER_8       &kp NUMBER_9     &kp NUMBER_0  &none
&mo 4           &kp LC(A)     &kp LC(S)     &kp LC(D)     &kp LC(F)     &kp LC(G)       &kp LEFT      &kp DOWN_ARROW  &kp UP_ARROW       &kp RIGHT_ARROW  &none         &none
&kp LEFT_SHIFT  &none         &none         &kp LC(C)     &none         &kp C_PREV      &kp C_NEXT    &kp C_MUTE      &kp K_VOLUME_DOWN  &kp K_VOLUME_UP  &kp C_PP      &kp RCTRL
                                            &kp LGUI      &none         &kp SPACE       &kp ENTER     &none           &kp LALT
            >;
        };

        raise_layer {
            bindings = <
&kp GRAVE  &kp EXCLAMATION     &kp AT              &kp HASH          &kp DOLLAR     &kp PERCENT          &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &none
&kp TAB    &kp LA(LEFT_ARROW)  &kp LA(DOWN_ARROW)  &kp LA(UP_ARROW)  &kp LA(RIGHT)  &kp LG(SPACE)        &kp MINUS       &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE       &none                  &mo 3
&kp LSHFT  &none               &none               &none             &none          &kp LA(BACKSPACE)    &kp UNDERSCORE  &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &none                  &kp LEFT_CONTROL
                                                   &kp RIGHT_GUI     &none          &kp SPACE            &kp BACKSPACE   &none          &kp LALT
            >;
        };

        fn {
            bindings = <
&kp ESCAPE  &kp F1            &kp F2         &kp F3        &kp F4             &kp F5       &kp F6         &kp F7  &kp F7  &kp F8  &kp F9  &kp F10
&none       &focusLeftEditor  &kp PAGE_DOWN  &kp PAGE_UP   &focusRightEditor  &kp F11      &kp F12        &none   &none   &none   &none   &none
&none       &mvEditorPrev     &none          &none         &mvEditorNext      &none        &none          &none   &none   &none   &none   &none
                                             &kp LEFT_GUI  &none              &kp SPACE    &kp BACKSPACE  &none   &none
            >;
        };

        controls {
            bindings = <
&bootloader  &kp LC(LA(LS(LEFT_ARROW)))  &kp LA(LG(UP_ARROW))    &kp LA(LC(RIGHT_ARROW))  &kp LA(LC(LG(RIGHT_ARROW)))  &kp LS(LA(LC(RIGHT_ARROW)))    &msc SCRL_LEFT  &msc SCRL_UP    &msc SCRL_DOWN  &msc SCRL_RIGHT  &none  &bootloader
&none        &kp LG(LA(LEFT))            &kp LA(LG(DOWN_ARROW))  &kp LG(LA(RIGHT))        &kp LG(LA(F))                &none                          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none  &none
&sys_reset   &bt BT_CLR                  &bt BT_SEL 0            &bt BT_SEL 1             &bt BT_SEL 2                 &none                          &mkp LCLK       &mkp RCLK       &mkp MB4        &mkp MB5         &none  &sys_reset
                                                                 &none                    &none                        &none                          &none           &none           &none
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};

// LEDs are per half for split keyboards

&led_strip { chain-length = <27>; };

&led_strip { chain-length = <27>; };
